# pins.env — every upstream input pinned (2026-10-01)
#
# Rule: nothing in this repo is vendored; everything below is fetched at
# build time. If any pin moves, the build is a different build — say so.

# --- Linux kernel (no local changes: upstream tag + linux/config.fragment) ---
LINUX_XLNX_TAG=xlnx_rebase_v6.6_LTS_2024.1_merge_6.6.80
LINUX_XLNX_REPO=https://github.com/Xilinx/linux-xlnx

# --- U-Boot (stock, unmodified) ---
UBOOT_VERSION=v2024.01
UBOOT_REPO=https://github.com/u-boot/u-boot

# --- FPGA bitstream (from zybo-dsp; this is the software side's record) ---
ZYBO_DSP_TAG=v0.3.0
# The running bitstream is built from the v0.3.0 tag (no second FIR) and
# verified on board (CAP0=0x5A440001, CAP1=0x1F7B, 13 slots live).
# Filled in after the release build lands in boot/:
BITSTREAM_SHA256=aa0bfccba730afde50dcbd9f5a9d6e6bba331f807a0ea89bf9c9792d28f9934a
BOOTBIN_SHA256=55e6414662fe8e157551961aca3294152725d1c02cf65ba8c49698d7043e727b

# --- Debian rootfs ---
DEBIAN_SUITE=trixie
DEBIAN_COMPONENTS="main contrib non-free non-free-firmware"

# --- AirPlay (cross-built by CI, see zybo-debian history) ---
SHAIRPORT_SYNC_VERSION=5.5.2
SHAIRPORT_AIRPLAY2=yes
NQPTP_VERSION=1.2.8

# --- Toolchains ---
VIVADO_VERSION=2024.1
GO_VERSION=1.27.1
GO_MODULE=zybo-audio-web
GO_DEPS="github.com/gorilla/websocket v1.5.3"
